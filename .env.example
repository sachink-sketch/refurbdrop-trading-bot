# ============================================================
# TRADING BOT CONFIGURATION
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Claude AI (required) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Choose your broker: ROBINHOOD | WEBULL | TDAMERITRADE ---
BROKER=ROBINHOOD

# --- Robinhood ---
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password
ROBINHOOD_MFA_CODE=        # Leave blank if no 2FA, or put TOTP code

# --- Webull ---
WEBULL_EMAIL=your_email@example.com
WEBULL_PASSWORD=your_password
WEBULL_TRADE_PIN=123456    # 6-digit trading PIN
WEBULL_DEVICE_ID=          # Auto-generated on first login

# --- TD Ameritrade / Schwab ---
TD_CLIENT_ID=your_app_client_id
TD_CLIENT_SECRET=your_app_client_secret
TD_REDIRECT_URI=https://localhost:8080
TD_TOKEN_PATH=./td_token.json
TD_ACCOUNT_NUMBER=         # Your account number (optional, uses first account)

# --- Bot Behavior ---
PAPER_TRADING=true         # STRONGLY recommended until you trust the bot
TRADE_INTERVAL_MINUTES=15  # How often to check for signals (min: 1)
MAX_TRADES_PER_DAY=10      # Safety cap on daily trade count

# --- Watchlist (comma-separated) ---
WATCHLIST=AAPL,TSLA,NVDA,AMZN,META,MSFT,SPY,QQQ,AMD,GOOGL

# --- Risk Management ---
MAX_POSITION_PCT=0.10      # Max % of portfolio per position (0.10 = 10%)
MAX_DAILY_LOSS_PCT=0.02    # Bot halts if daily loss exceeds this (0.02 = 2%)
STOP_LOSS_PCT=0.03         # Auto stop-loss on each position (0.03 = 3%)
TAKE_PROFIT_PCT=0.06       # Auto take-profit target (0.06 = 6%)
MIN_CONFIDENCE=0.65        # Claude AI min confidence to trade (0-1)

# --- Logging ---
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/bot.log
